generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EstadoVenta {
  PENDIENTE
  PAGADA
  CANCELADA
  ENTREGADA
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  OTRO
}

enum EstadoPago {
  PENDIENTE
  PAGADO
  FALLIDO
}

enum TipoMovimientoInventario {
  ENTRADA
  SALIDA
  AJUSTE
}

enum TipoPromocion {
  PORCENTAJE
  MONTO
}

model Rol {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique @db.VarChar(50)
  descripcion String?   @db.VarChar(160)
  usuarios    Usuario[]

  @@map("roles")
}

model Usuario {
  id             Int     @id @default(autoincrement())
  nombres        String  @db.VarChar(80)
  apellidos      String  @db.VarChar(80)
  correo         String  @unique @db.VarChar(160)
  contrasenaHash String  @db.VarChar(255)
  activo         Boolean @default(true)
  rolId          Int

  rol                   Rol                    @relation(fields: [rolId], references: [id])
  cliente               Cliente?
  ventas                Venta[]
  movimientosInventario MovimientoInventario[]

  @@map("usuarios")
}

model Cliente {
  id        Int     @id @default(autoincrement())
  usuarioId Int?    @unique
  nombres   String  @db.VarChar(80)
  apellidos String  @db.VarChar(80)
  correo    String  @unique @db.VarChar(160)
  telefono  String? @db.VarChar(30)
  cedula    String? @unique @db.VarChar(30)
  direccion String? @db.VarChar(255)
  ciudad    String? @db.VarChar(80)

  usuario Usuario? @relation(fields: [usuarioId], references: [id])
  ventas  Venta[]

  @@map("clientes")
}

model Categoria {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique @db.VarChar(100)
  descripcion String?    @db.VarChar(220)
  activo      Boolean    @default(true)
  productos   Producto[]

  @@map("categorias")
}

model Marca {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique @db.VarChar(100)
  paisOrigen  String?    @db.VarChar(80)
  descripcion String?    @db.VarChar(220)
  activo      Boolean    @default(true)
  productos   Producto[]

  @@map("marcas")
}

model Producto {
  id          Int     @id @default(autoincrement())
  nombre      String  @db.VarChar(160)
  codigo      String  @unique @db.VarChar(80)
  descripcion String?
  precio      Decimal @db.Decimal(10, 2)
  volumenMl   Int?
  imagenUrl   String? @db.VarChar(500)
  activo      Boolean @default(true)
  categoriaId Int
  marcaId     Int

  categoria     Categoria              @relation(fields: [categoriaId], references: [id])
  marca         Marca                  @relation(fields: [marcaId], references: [id])
  inventario    Inventario?
  detalleVentas DetalleVenta[]
  movimientos   MovimientoInventario[]
  promociones   Promocion[]

  @@map("productos")
}

model Inventario {
  id            Int      @id @default(autoincrement())
  productoId    Int      @unique
  stock         Int      @default(0)
  stockMinimo   Int      @default(0)
  ubicacion     String?  @db.VarChar(100)
  actualizadoEn DateTime @updatedAt

  producto Producto @relation(fields: [productoId], references: [id])

  @@map("inventario")
}

model MovimientoInventario {
  id         Int                      @id @default(autoincrement())
  productoId Int
  tipo       TipoMovimientoInventario
  cantidad   Int
  motivo     String                   @db.VarChar(180)
  usuarioId  Int?
  ventaId    Int?
  fecha      DateTime                 @default(now())

  producto Producto @relation(fields: [productoId], references: [id])
  usuario  Usuario? @relation(fields: [usuarioId], references: [id])
  venta    Venta?   @relation(fields: [ventaId], references: [id])

  @@map("movimientos_inventario")
}

model Venta {
  id        Int         @id @default(autoincrement())
  clienteId Int?
  usuarioId Int?
  estado    EstadoVenta @default(PENDIENTE)
  subtotal  Decimal     @default(0) @db.Decimal(10, 2)
  impuesto  Decimal     @default(0) @db.Decimal(10, 2)
  total     Decimal     @default(0) @db.Decimal(10, 2)
  fecha     DateTime    @default(now())

  cliente               Cliente?               @relation(fields: [clienteId], references: [id])
  usuario               Usuario?               @relation(fields: [usuarioId], references: [id])
  detalles              DetalleVenta[]
  pagos                 Pago[]
  factura               Factura?
  movimientosInventario MovimientoInventario[]

  @@map("ventas")
}

model DetalleVenta {
  id             Int     @id @default(autoincrement())
  ventaId        Int
  productoId     Int
  cantidad       Int
  precioUnitario Decimal @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)

  venta    Venta    @relation(fields: [ventaId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@map("detalle_ventas")
}

model Pago {
  id        Int        @id @default(autoincrement())
  ventaId   Int
  metodo    MetodoPago
  estado    EstadoPago @default(PENDIENTE)
  monto     Decimal    @db.Decimal(10, 2)
  fechaPago DateTime?

  venta Venta @relation(fields: [ventaId], references: [id])

  @@map("pagos")
}

model Factura {
  id            Int      @id @default(autoincrement())
  ventaId       Int      @unique
  numeroFactura String   @unique @db.VarChar(50)
  nombreCliente String   @db.VarChar(120)
  cedulaCliente String?  @db.VarChar(30)
  subtotal      Decimal  @db.Decimal(10, 2)
  impuesto      Decimal  @db.Decimal(10, 2)
  total         Decimal  @db.Decimal(10, 2)
  fechaEmision  DateTime @default(now())

  venta Venta @relation(fields: [ventaId], references: [id])

  @@map("facturas")
}

model Promocion {
  id          Int           @id @default(autoincrement())
  productoId  Int
  nombre      String        @db.VarChar(120)
  descripcion String?       @db.VarChar(220)
  tipo        TipoPromocion
  valor       Decimal       @db.Decimal(10, 2)
  fechaInicio DateTime
  fechaFin    DateTime
  activo      Boolean       @default(true)

  producto Producto @relation(fields: [productoId], references: [id])

  @@map("promociones")
}
