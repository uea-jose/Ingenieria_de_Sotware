generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EstadoVenta {
  PENDIENTE
  PAGADA
  CANCELADA
  ENTREGADA
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  OTRO
}

enum EstadoPago {
  PENDIENTE
  PAGADO
  FALLIDO
}

enum TipoMovimientoInventario {
  ENTRADA
  SALIDA
  AJUSTE
}

enum TipoPromocion {
  PORCENTAJE
  MONTO
}

enum GeneroPerfume {
  MASCULINO
  FEMENINO
  UNISEX
}

enum SegmentoReferencia {
  DISENADOR
  NICHO
}

enum EstadoPublicacion {
  BORRADOR
  PUBLICADO
  OCULTO
}

enum DisponibilidadProducto {
  DISPONIBLE
  STOCK_BAJO
  AGOTADO
  BAJO_PEDIDO
}

model Rol {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique @db.VarChar(50)
  descripcion String?   @db.VarChar(160)
  usuarios    Usuario[]

  @@map("roles")
}

model Usuario {
  id             Int     @id @default(autoincrement())
  nombres        String  @db.VarChar(80)
  apellidos      String  @db.VarChar(80)
  correo         String  @unique @db.VarChar(160)
  contrasenaHash String  @db.VarChar(255)
  activo         Boolean @default(true)
  rolId          Int

  rol                   Rol                    @relation(fields: [rolId], references: [id])
  cliente               Cliente?
  ventas                Venta[]
  movimientosInventario MovimientoInventario[]

  @@map("usuarios")
}

model Cliente {
  id        Int     @id @default(autoincrement())
  usuarioId Int?    @unique
  nombres   String  @db.VarChar(80)
  apellidos String  @db.VarChar(80)
  correo    String  @unique @db.VarChar(160)
  telefono  String? @db.VarChar(30)
  cedula    String? @unique @db.VarChar(30)
  direccion String? @db.VarChar(255)
  ciudad    String? @db.VarChar(80)

  usuario Usuario? @relation(fields: [usuarioId], references: [id])
  ventas  Venta[]

  @@map("clientes")
}

model Categoria {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique @db.VarChar(100)
  descripcion String?    @db.VarChar(220)
  activo      Boolean    @default(true)
  productos   Producto[]

  @@map("categorias")
}

model Marca {
  id          Int                 @id @default(autoincrement())
  nombre      String              @unique @db.VarChar(100)
  paisOrigen  String?             @db.VarChar(80)
  descripcion String?             @db.VarChar(220)
  activo      Boolean             @default(true)
  productos   Producto[]
  referencias ReferenciaPerfume[]

  @@map("marcas")
}

model Producto {
  id                             Int                    @id @default(autoincrement())
  nombre                         String                 @db.VarChar(160)
  codigo                         String                 @unique @db.VarChar(80)
  slug                           String?                @unique @db.VarChar(180)
  descripcionCorta               String?                @db.VarChar(280)
  descripcion                    String?
  precio                         Decimal                @db.Decimal(10, 2)
  volumenMl                      Int?
  imagenUrl                      String?                @db.VarChar(500)
  activo                         Boolean                @default(true)
  estadoPublicacion              EstadoPublicacion      @default(BORRADOR)
  disponibilidad                 DisponibilidadProducto @default(DISPONIBLE)
  destacado                      Boolean                @default(false)
  versionPerfilReferenciaCopiado Int                    @default(1)
  acordesCopiadosEn              DateTime?
  categoriaId                    Int
  marcaId                        Int
  referenciaId                   Int?

  categoria      Categoria              @relation(fields: [categoriaId], references: [id])
  marca          Marca                  @relation(fields: [marcaId], references: [id])
  referencia     ReferenciaPerfume?     @relation(fields: [referenciaId], references: [id], onDelete: Restrict)
  inventario     Inventario?
  detalleVentas  DetalleVenta[]
  movimientos    MovimientoInventario[]
  promociones    Promocion[]
  acordes        ProductoAcorde[]
  presentaciones PresentacionProducto[]
  imagenes       ImagenProducto[]

  @@index([referenciaId])
  @@index([estadoPublicacion, disponibilidad, destacado])
  @@map("productos")
}

model Acorde {
  id            Int                       @id @default(autoincrement())
  nombre        String                    @unique @db.VarChar(100)
  slug          String                    @unique @db.VarChar(120)
  colorHex      String                    @db.Char(7)
  colorTextoHex String                    @default("#111111") @db.Char(7)
  origenColor   String                    @default("catalogo_maestro") @db.VarChar(80)
  alias         String[]                  @default([])
  activo        Boolean                   @default(true)
  creadoEn      DateTime                  @default(now())
  actualizadoEn DateTime                  @updatedAt
  referencias   ReferenciaPerfumeAcorde[]
  productos     ProductoAcorde[]

  @@map("acordes")
}

model ReferenciaPerfume {
  id                  Int                       @id @default(autoincrement())
  marcaId             Int
  nombre              String                    @db.VarChar(180)
  slug                String                    @unique @db.VarChar(180)
  genero              GeneroPerfume
  segmento            SegmentoReferencia        @default(DISENADOR)
  aliasCatalogo       String?                   @db.VarChar(180)
  catalogoFuente      String?                   @db.VarChar(255)
  paginaFuente        Int?
  entradaFuente       Int?
  versionPerfil       Int                       @default(1)
  perfilActualizadoEn DateTime                  @default(now())
  activo              Boolean                   @default(true)
  creadoEn            DateTime                  @default(now())
  actualizadoEn       DateTime                  @updatedAt
  marca               Marca                     @relation(fields: [marcaId], references: [id], onDelete: Restrict)
  acordes             ReferenciaPerfumeAcorde[]
  productos           Producto[]

  @@unique([marcaId, nombre])
  @@index([marcaId, activo, genero])
  @@map("referencias_perfume")
}

model ReferenciaPerfumeAcorde {
  referenciaId  Int
  acordeId      Int
  intensidad    Int               @db.SmallInt
  ordenVisual   Int               @db.SmallInt
  metodoFuente  String            @default("estimacion_visual_catalogo") @db.VarChar(80)
  confianza     Decimal           @default(0.75) @db.Decimal(3, 2)
  creadoEn      DateTime          @default(now())
  actualizadoEn DateTime          @updatedAt
  referencia    ReferenciaPerfume @relation(fields: [referenciaId], references: [id], onDelete: Cascade)
  acorde        Acorde            @relation(fields: [acordeId], references: [id], onDelete: Restrict)

  @@id([referenciaId, acordeId])
  @@unique([referenciaId, ordenVisual])
  @@index([acordeId, intensidad])
  @@map("referencias_perfume_acordes")
}

model ProductoAcorde {
  productoId          Int
  acordeId            Int
  intensidad          Int      @db.SmallInt
  ordenVisual         Int      @db.SmallInt
  copiadoDeReferencia Boolean  @default(true)
  creadoEn            DateTime @default(now())
  actualizadoEn       DateTime @updatedAt
  producto            Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  acorde              Acorde   @relation(fields: [acordeId], references: [id], onDelete: Restrict)

  @@id([productoId, acordeId])
  @@unique([productoId, ordenVisual])
  @@index([acordeId, intensidad])
  @@map("productos_acordes")
}

model PresentacionProducto {
  id                Int      @id @default(autoincrement())
  productoId        Int
  etiqueta          String   @db.VarChar(120)
  volumenMl         Decimal? @db.Decimal(7, 2)
  precio            Decimal  @db.Decimal(12, 2)
  precioPromocional Decimal? @db.Decimal(12, 2)
  moneda            String   @default("COP") @db.Char(3)
  principal         Boolean  @default(false)
  activo            Boolean  @default(true)
  creadoEn          DateTime @default(now())
  actualizadoEn     DateTime @updatedAt
  producto          Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([productoId, etiqueta])
  @@index([productoId, activo])
  @@map("presentaciones_producto")
}

model ImagenProducto {
  id               Int      @id @default(autoincrement())
  productoId       Int
  rutaStorage      String   @unique @db.VarChar(500)
  textoAlternativo String   @db.VarChar(240)
  ordenVisual      Int      @db.SmallInt
  principal        Boolean  @default(false)
  activo           Boolean  @default(true)
  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt
  producto         Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([productoId, ordenVisual])
  @@index([productoId, activo, ordenVisual])
  @@map("imagenes_producto")
}

model Inventario {
  id            Int      @id @default(autoincrement())
  productoId    Int      @unique
  stock         Int      @default(0)
  stockMinimo   Int      @default(0)
  ubicacion     String?  @db.VarChar(100)
  actualizadoEn DateTime @updatedAt

  producto Producto @relation(fields: [productoId], references: [id])

  @@map("inventario")
}

model MovimientoInventario {
  id         Int                      @id @default(autoincrement())
  productoId Int
  tipo       TipoMovimientoInventario
  cantidad   Int
  motivo     String                   @db.VarChar(180)
  usuarioId  Int?
  ventaId    Int?
  fecha      DateTime                 @default(now())

  producto Producto @relation(fields: [productoId], references: [id])
  usuario  Usuario? @relation(fields: [usuarioId], references: [id])
  venta    Venta?   @relation(fields: [ventaId], references: [id])

  @@map("movimientos_inventario")
}

model Venta {
  id        Int         @id @default(autoincrement())
  clienteId Int?
  usuarioId Int?
  estado    EstadoVenta @default(PENDIENTE)
  subtotal  Decimal     @default(0) @db.Decimal(10, 2)
  impuesto  Decimal     @default(0) @db.Decimal(10, 2)
  total     Decimal     @default(0) @db.Decimal(10, 2)
  fecha     DateTime    @default(now())

  cliente               Cliente?               @relation(fields: [clienteId], references: [id])
  usuario               Usuario?               @relation(fields: [usuarioId], references: [id])
  detalles              DetalleVenta[]
  pagos                 Pago[]
  factura               Factura?
  movimientosInventario MovimientoInventario[]

  @@map("ventas")
}

model DetalleVenta {
  id             Int     @id @default(autoincrement())
  ventaId        Int
  productoId     Int
  cantidad       Int
  precioUnitario Decimal @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)

  venta    Venta    @relation(fields: [ventaId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@map("detalle_ventas")
}

model Pago {
  id        Int        @id @default(autoincrement())
  ventaId   Int
  metodo    MetodoPago
  estado    EstadoPago @default(PENDIENTE)
  monto     Decimal    @db.Decimal(10, 2)
  fechaPago DateTime?

  venta Venta @relation(fields: [ventaId], references: [id])

  @@map("pagos")
}

model Factura {
  id            Int      @id @default(autoincrement())
  ventaId       Int      @unique
  numeroFactura String   @unique @db.VarChar(50)
  nombreCliente String   @db.VarChar(120)
  cedulaCliente String?  @db.VarChar(30)
  subtotal      Decimal  @db.Decimal(10, 2)
  impuesto      Decimal  @db.Decimal(10, 2)
  total         Decimal  @db.Decimal(10, 2)
  fechaEmision  DateTime @default(now())

  venta Venta @relation(fields: [ventaId], references: [id])

  @@map("facturas")
}

model Promocion {
  id          Int           @id @default(autoincrement())
  productoId  Int
  nombre      String        @db.VarChar(120)
  descripcion String?       @db.VarChar(220)
  tipo        TipoPromocion
  valor       Decimal       @db.Decimal(10, 2)
  fechaInicio DateTime
  fechaFin    DateTime
  activo      Boolean       @default(true)

  producto Producto @relation(fields: [productoId], references: [id])

  @@map("promociones")
}

model AuditoriaLog {
  id               Int      @id @default(autoincrement())
  fecha            DateTime @default(now())
  path             String   @db.VarChar(255)
  metodo           String   @db.VarChar(10)
  datoIngreso      Json?
  datoRespuesta    Json?
  traceId          String   @db.VarChar(80)
  guidSesion       String   @db.VarChar(80)
  usuarioId        Int?
  clienteId        Int?
  ventaId          Int?
  productoId       Int?
  estadoHttp       Int?
  duracionMs       Int?
  resultado        String   @db.VarChar(40)
  codigoRespuesta  String?  @db.VarChar(80)
  mensajeRespuesta String?  @db.VarChar(255)

  @@index([traceId])
  @@index([guidSesion])
  @@index([usuarioId])
  @@index([clienteId])
  @@index([ventaId])
  @@index([productoId])
  @@index([path])
  @@map("auditoria_logs")
}
